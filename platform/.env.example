# SynapseMD Platform Environment

APP_ENV=development
DEBUG=true
DATABASE_URL=sqlite+aiosqlite:///./synapsemd.db
# Enterprise / Compose: postgresql+asyncpg://synapsemd:synapsemd@localhost:5432/synapsemd
HEALTH_STORE=json
# json | postgres | dual  (postgres is SoR; json is local IDE/CLI vault)
AUTO_CREATE_SCHEMA=false
OBJECT_STORE_BACKEND=memory
# memory | s3  (blobs never stored in Postgres; DB keeps URI + sha256)
OBJECT_STORE_BUCKET=synapsemd
OBJECT_STORE_ENDPOINT=
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_SECRET_PREVIOUS=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
AUTH_BFF_COOKIES=false

OIDC_ISSUER=
OIDC_AUDIENCE=synapsemd-api
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/oidc/callback
CORS_ORIGINS=*
# staging/prod: comma-separated allowlist, never *

VAULT_URL=http://localhost:8200
VAULT_TOKEN=dev-root-token
VAULT_ENABLED=false

FHIR_BASE_URL=http://localhost:8080/fhir
FHIR_LOCAL_STORE=./data/fhir
FHIR_USE_HAPI=false

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_AUDIT_TOPIC=synapsemd.audit.events
AUDIT_USE_MEMORY=true
# Compose/Postgres SoR: AUDIT_USE_MEMORY=false (durable hash-chained audit_events)
AUDIT_USE_KAFKA=false
AUDIT_LEGAL_HOLD=false

LLM_DEFAULT_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_BAA_SIGNED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_BAA_SIGNED=false
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com
GOOGLE_BAA_SIGNED=false

PRESIDIO_ENABLED=false
# unset in staging/prod → Presidio on by default
PHI_BLOCK_ON_FAILURE=true
AI_NARRATIVE_OVERLAY=false

VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=local-model
VLLM_MTLS_CERT=
VLLM_MTLS_KEY=

RAG_VECTOR_STORE=memory
RAG_VECTOR_STORE_PATH=./data/rag
ORG_INTELLIGENCE_ENABLED=false

MCP_ENABLED=true
ENABLE_METRICS=true
ENABLE_TRACING=true

# MCP client token (set after login)
SYNAPSEMD_ACCESS_TOKEN=
